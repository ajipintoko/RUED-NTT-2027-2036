# LEAP archives and Excel workbooks are binary: Git LFS
*.leap filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text
*.xlsm filter=lfs diff=lfs merge=lfs -text

# Text files: normalise line endings
*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.py text eol=lf
*.docx filter=lfs diff=lfs merge=lfs -text
